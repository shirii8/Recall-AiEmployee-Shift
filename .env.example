#free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here
# Optional: which model to use
GEMINI_MODEL=gemini-3.8-flash
# Optional: free keys allow few requests per minute; 6 seconds keeps you under 10/min
GEMINI_MIN_SECONDS_BETWEEN_CALLS=0
# Optional: models to switch to, in order, when the daily free quota of the one above runs out
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
